# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=8001

# Postgres. On Supabase: DATABASE_URL = transaction pooler (port 6543, ?pgbouncer=true),
# DIRECT_URL = session pooler or direct connection (used by `prisma migrate deploy`).
# Locally both can point at the same database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/car"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/car"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Comma-separated origins allowed to call the API (the frontend URL in production)
CORS_ORIGIN="http://localhost:3000"

# Refresh-token cookie. Keep "lax" when the frontend proxies /api (same site).
# Use "none" only if the browser calls the API on a different site directly.
COOKIE_SAMESITE="lax"
# COOKIE_SECURE=true          # defaults to true when NODE_ENV=production

# Number of proxy hops in front of the app (Render = 1, Netlify rewrite + Render = 2)
TRUST_PROXY=1

# Swagger UI at /api/docs: on in development, off in production unless set to true
# ENABLE_SWAGGER=false

# Only for scripts
# SEED_PASSWORD=...           # npm run seed (wipes the DB! refused when NODE_ENV=production)
# ADMIN_EMAIL=... ADMIN_PASSWORD=...   # npm run admin:create
